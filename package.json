{
  "name": "spendly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "mobile": "expo start",
    "mobile:web": "expo start --web",
    "mobile:export": "expo export --platform ios --platform android --output-dir /tmp/canibuyit-expo",
    "demo:seed-sql": "tsx scripts/demo-seed.ts",
    "demo:verify": "tsx --env-file=.env.local scripts/verify-demo.ts",
    "nessie:setup": "node --env-file=.env.local --import tsx scripts/setup-nessie.ts",
    "nessie:seed": "node --env-file=.env.local --import tsx scripts/seed-nessie.ts",
    "nessie:test": "node --env-file=.env.local --import tsx scripts/test-nessie.ts",
    "nessie:expense:test": "node --env-file=.env.local --import tsx scripts/verify-nessie-expense.ts",
    "gemini:image": "node --env-file=.env.local --import tsx scripts/test-gemini-image.ts",
    "mobile:verify-api": "node --env-file=.env.local --import tsx scripts/verify-mobile-api.ts",
    "auth:link": "node --env-file=.env.local --import tsx scripts/link-user-integrations.ts",
    "auth:test": "AUTH_INTEGRATION_TESTS=true node --env-file=.env.local --import tsx --test tests/auth.integration.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "argon2": "^0.45.1",
    "backboard-sdk": "^1.5.16",
    "expo": "^57.0.22",
    "expo-constants": "~57.0.18",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "pg": "^8.19.0",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "recharts": "^3.7.0",
    "sharp": "0.35.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "main": "expo-router/entry"
}
