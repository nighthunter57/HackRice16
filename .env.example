# Copy to .env.local. Authentication needs the database and JWT secrets; never commit credentials.
NESSIE_API_KEY=
DEMO_MODE=false
NESSIE_CUSTOMER_ID=
# Created once by npm run nessie:setup; primary demo checking account.
NESSIE_ACCOUNT_ID=
# Explicit development-only sandbox expense action (one pending repair per day).
NESSIE_DEMO_EXPENSE_ENABLED=false
# Optional validated internal bills/income/goals file, scoped to the customer.
NESSIE_SCHEDULE_PATH=
NESSIE_BASE_URL=https://api.nessieisreal.com
FINANCIAL_DATA_MODE=auto

# PostgreSQL connection string using your Tiger provider's TLS settings.
DATABASE_URL=
# Legacy alias (DATABASE_URL takes precedence):
TIGER_DATABASE_URL=
# Optional trusted CA PEM path; certificate and hostname verification stay enabled.
TIGER_CA_CERT_PATH=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# An assistant dedicated to this one demo user.
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Authentication requires PostgreSQL and two independent random secrets (32+ bytes).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Comma-separated exact browser origins; native requests do not send Origin.
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
AUTH_TRUST_PROXY=false
# Optional Resend delivery; development otherwise prints a reset link server-side.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# Use your deployed HTTPS reset page in production.
PASSWORD_RESET_URL=spendly://reset-password

# Expo mobile backend URL. On a phone use the Mac's reachable LAN/HTTPS URL,
# never localhost. Restart Expo after changes. The Mac's LAN address can change.
EXPO_PUBLIC_API_URL=

# Optional server-only paid UPCitemdb catalog lookup; absent means visual/text matches still work.
UPCITEMDB_API_KEY=

# Optional MathWorks integration settings (currently inactive).
MATHWORKS_ENABLED=false
MATLAB_SERVICE_URL=

# Server-only schedule for hosted deployments; replaces a machine-local file path.
NESSIE_SCHEDULE_JSON=
